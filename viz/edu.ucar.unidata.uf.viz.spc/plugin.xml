<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

	<extension
	      point="org.eclipse.ui.commands">
	      <command
	      	 name="Load SPC Resource"
             id="edu.ucar.unidata.uf.viz.spc.loadSPCResource">
	      </command>
	</extension>
	
	<extension
	      point="org.eclipse.ui.handlers">
	      <handler
             commandId="edu.ucar.unidata.uf.viz.spc.loadSPCResource"
             class="edu.ucar.unidata.uf.viz.spc.rsc.SPCResourceLoader">
	      </handler>
	</extension>
	

    <extension point="org.eclipse.ui.menus">
        <menuContribution
                locationURI="menu:ncepHydro?after=SPC">
            <command
                    commandId="edu.ucar.unidata.uf.viz.spc.loadSPCResource"
                    label="Load SPC Outlook..."
                    style="push" />
        </menuContribution>
    </extension>
</plugin>
