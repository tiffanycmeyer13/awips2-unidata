<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

    <extension
          point="org.eclipse.ui.commands">
          <command
             name="Load SPC Resource"
             id="edu.ucar.unidata.uf.viz.spc.loadSPCResource">
          </command>
    </extension>

    <extension
          point="org.eclipse.ui.handlers">
          <handler
             commandId="edu.ucar.unidata.uf.viz.spc.loadSPCResource"
             class="edu.ucar.unidata.uf.viz.spc.rsc.SPCResourceLoader">
          </handler>
    </extension>

    <extension
          point="com.raytheon.uf.viz.core.resource">
        <resource
             class="edu.ucar.unidata.uf.viz.spc.rsc.SPCResource"
             name="SPCResource"
             recordClass="edu.ucar.unidata.common.dataplugin.spc.SPCRecord"
             renderingOrderId="PLOT"
             resourceType="PLAN_VIEW">
        </resource>
    </extension>

    <extension
          point="com.raytheon.viz.ui.contextualMenu">
        <contextualMenu
              actionClass="edu.ucar.unidata.uf.viz.spc.rsc.SPCFillToggleAction"
              capabilityClass="edu.ucar.unidata.uf.viz.spc.rsc.SPCResource"
              name="Show Risk Fill"
              sortID="500">
        </contextualMenu>
    </extension>

</plugin>
